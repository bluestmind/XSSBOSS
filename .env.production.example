POSTGRES_PASSWORD=replace-with-a-long-random-password
SECRET_KEY=replace-with-at-least-32-random-characters
API_AUTH_TOKEN=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=https://scanner.example.com
# Public HTTPS origin whose /api/v1/oracle path routes to the API.
ORACLE_SERVER_URL=https://scanner.example.com
BURP_ENABLED=False
BURP_API_KEY=
BURP_AUTO_START=False
BURP_PROGRAM_AUTO_SCAN=False
BURP_EXECUTABLE=
BURP_JAVA_EXECUTABLE=
BURP_STARTUP_TIMEOUT_SECONDS=45
BURP_PROXY_WORKERS=False
PROXY_ENABLED=False
UPSTREAM_ROTATING_PROXY_ENABLED=False
WAF_BYPASS_HEADERS=False
ALLOW_INSECURE_TLS=False
LLM_ENABLED=False
LLM_PREFER_LOCAL=True
LLM_API_URL=http://127.0.0.1:11434/api/generate
LLM_MODEL=WhiteRabbitNeo/WhiteRabbitNeo-V3-7B:latest
LLM_TIMEOUT_SECONDS=180
LLM_KEEP_ALIVE=30m
LLM_NUM_CTX=8192
LLM_MAX_OUTPUT_TOKENS=768
LLM_TEMPERATURE=0.1
LLM_CAMPAIGN_ADVISOR=True
LLM_MIDSCAN_ADVISOR=True
LLM_MIDSCAN_MAX_CALLS=8
LLM_MIDSCAN_MIN_CONFIDENCE=0.65
LLM_WORKFLOW_ADVISOR=True
LLM_WORKFLOW_MAX_CALLS=6
LLM_ALLOW_REMOTE_SECURITY_DATA=False
BROWSER_LEASE_SECONDS=900
# The production image ships a pinned Playwright Chromium. A custom UC image
# must explicitly install a compatible system Chrome before enabling this.
USE_UNDETECTED_CHROME=False
BROWSER_NAVIGATION_TIMEOUT=25
ORACLE_WAIT_TIMEOUT=2.0
BROWSER_RESTART_EVERY_TESTS=20
BYPASS_CSP=False
CAPTURE_SCREENSHOTS=hits
CAPTURE_DOM_SNAPSHOT=hits
# Browser-native, value-free runtime evidence: all, hits, or off.
CAPTURE_RUNTIME_COVERAGE=all
CAPTURE_RUNTIME_LINEAGE=all
# Fixed-order A/A/B adds three inert GET navigations and yields order-confounded
# prioritization evidence only. It cannot confirm XSS.
RUNTIME_LINEAGE_AAB_PROBES=False
# Authenticates the worker's redacted projection, not hostile-page truth.
RUNTIME_LINEAGE_HMAC_KEY_VERSION=1
CAPTURE_DOM_DIFFERENTIAL=all
DOM_SNAPSHOT_MAX_CHARS=8000
# High-yield first pass. Use max_coverage selectively for unresolved contexts.
MAX_PAYLOADS_PER_CONTEXT=32
MAX_TEST_CASES_PER_EXPERIMENT=1500
MAX_QUEUE_ACTIVE=1
MAX_PROFILING_WORKERS=1
REQUEST_DELAY_MS=1200
MAX_REQUESTS_PER_MINUTE=40
RATE_LIMIT_REDIS_ENABLED=True
RATE_LIMIT_REDIS_REQUIRED=True
RATE_LIMIT_REDIS_RETRY_SECS=30
RATE_LIMIT_FALLBACK_WORKER_ESTIMATE=8
ADAPTIVE_THROTTLE=True
THROTTLE_BACKOFF_MULTIPLIER=2.5
THROTTLE_MAX_DELAY_MS=60000
JITTER_FACTOR=0.15
CIRCUIT_BREAKER_ENABLED=True
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECS=120
ROTATE_USER_AGENT=False
CELERY_VISIBILITY_TIMEOUT=7200
EVIDENCE_DIR=/app/evidence
AUDIT_MODE=celery
TENANT_API_TOKENS=
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
